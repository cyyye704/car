{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "STC32G: Rebuild LED (Keil C251)",
      "detail": "Full rebuild and fresh HEX verification. Tasks documentation: https://code.visualstudio.com/docs/debugtest/tasks",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\build-led.ps1"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "runOptions": { "instanceLimit": 1 },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": {
        "owner": "keil-c251",
        "source": "Keil C251",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^KEIL_DIAGNOSTIC (.+)\\((\\d+)\\): (error|warning) ([A-Za-z0-9_]+): (.*)$",
          "file": 1,
          "line": 2,
          "severity": 3,
          "code": 4,
          "message": 5
        }
      }
    },
    {
      "label": "STC32G: Show last LED build log",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\build-led.ps1",
        "-ShowLog"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "STC32G: Rebuild motor test (Keil C251)",
      "detail": "Full rebuild and fresh MOTOR_TEST HEX verification; select explicitly with Run Task. LED remains the default build.",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\build-motor.ps1"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": false },
      "runOptions": { "instanceLimit": 1 },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": {
        "owner": "keil-c251",
        "source": "Keil C251",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^KEIL_DIAGNOSTIC (.+)\\((\\d+)\\): (error|warning) ([A-Za-z0-9_]+): (.*)$",
          "file": 1,
          "line": 2,
          "severity": 3,
          "code": 4,
          "message": 5
        }
      }
    },
    {
      "label": "STC32G: Show last motor test build log",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\build-motor.ps1",
        "-ShowLog"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    }
  ]
}
